/api/market/coingecko-coin*
  Cache-Control: public, s-maxage=300, stale-while-revalidate=600

# === API: Weather (medium frequency) — 10 min cache ===
/api/weather*
  Cache-Control: public, s-maxage=600, stale-while-revalidate=1200


# Cloudflare Workers Static Assets custom headers
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# IMPORTANT: This file ONLY affects responses served directly by the
# static-assets layer (static files like /_next/static/*, /sw.js,
# /manifest.json, images, fonts). It does NOT affect responses
# generated by the Worker script itself (pages and API routes).
#
# For dynamic-route security headers, see next.config.ts headers().
# For API route Cache-Control, each route handler sets its own headers.

# === Static assets (immutable, 1 year) ===
# Next.js content-hashed assets — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# === Fonts (immutable, 1 year) ===
/_next/static/media/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# === Service worker — must revalidate every time ===
# Otherwise users may get stuck on an old SW version.
/sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /

# === Manifest — short cache, frequent updates ===
/manifest.json
  Cache-Control: public, max-age=3600

# === HTML pages — never cache (always fresh) ===
/*.html
  Cache-Control: no-cache

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Local SQLite DB (sandbox artifact)
db/*.db
db/*.db-journal

# vercel
.vercel

# OpenNext Cloudflare adapter — build output (generated by `opennextjs-cloudflare build`)
# Contains the bundled Worker, static assets, and server functions.
.open-next/

# Local Cloudflare bindings (R2/D1/KV) — used by `initOpenNextCloudflareForDev`
# in next.config.ts for local development. Contains local development secrets.
.dev.vars

# Generated TypeScript types for Cloudflare bindings (regenerated by `npm run cf-typegen`)
cloudflare-env.d.ts

# Wrangler cache (regenerated on each build)
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Agent Browser screenshots (test artifacts, not for git)
/screenshots/

# Local scripts (working dir for build scripts) — keep restart-dev.sh + audit-sources.py
/scripts/*
!/scripts/restart-dev.sh
!/scripts/audit-sources.py

# Dev-server PID files
.zscripts/*.pid

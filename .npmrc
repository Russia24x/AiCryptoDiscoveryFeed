# .npmrc — npm configuration
# Tells npm to ignore peer dependency conflicts.
# Required because @cloudflare/next-on-pages@1.x officially supports
# Next.js <= 15.5.2, but our project uses Next.js 16.
# The adapter works fine with Next.js 16 despite the peer dep warning.

legacy-peer-deps=true

# Also enable faster installs
fund=false
audit=false
